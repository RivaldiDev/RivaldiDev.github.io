<section class="section" id="terminal">
    <p class="section__index mono reveal" data-i18n="terminal.index">04 Interaktif</p>
    <h2 class="section__title reveal" data-i18n="terminal.title">Bicara dengan mesin</h2>
    <p class="section__sub reveal" data-i18n="terminal.sub">Shell sungguhan. Coba <code>help</code> — atau main <code>snake</code> dan <code>donut</code>.</p>
    <div class="term reveal">
      <div class="term__bar mono"><span data-i18n="terminal.win">rivaldi.dev — terminal</span></div>
      <div class="term__body mono" id="shell-out"></div>
      <div class="term__input mono">
        <label for="shell-in">$</label>
        <input id="shell-in" type="text" autocomplete="off" spellcheck="false" aria-label="terminal input">
      </div>
    </div>
  </section>

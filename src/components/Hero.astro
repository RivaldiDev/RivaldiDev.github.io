---
import HeroStars from "@/components/islands/HeroStars";
import RoleTyping from "@/components/islands/RoleTyping";
---
<header class="hero" id="top">
    <HeroStars client:idle />
    <p class="eyebrow mono reveal" data-i18n="hero.eyebrow">Portofolio</p>
    <h1 class="hero__title reveal" data-i18n="hero.title">Membangun web baru,<br>bersama <em>agen AI</em>.</h1>
    <p class="hero__role mono reveal"><RoleTyping client:load /></p>
    <p class="hero__lead reveal" data-i18n="hero.lead">
      Saya <strong>Rivaldi</strong> — developer dari Indonesia. Dasbor onchain,
      alat berbasis AI, dan eksperimen web3: dirakit cepat, dirilis rapi.
    </p>
    <div class="hero__cta reveal">
      <a class="link-btn" href="#projects" data-i18n="hero.cta1">Lihat proyek ↓</a>
      <a class="link-btn link-btn--dim" href="#terminal" data-i18n="hero.cta2">Buka terminal →</a>
    </div>
  </header>

<div class="ascii-band reveal">
    <canvas id="ascii" aria-hidden="true"></canvas>
  </div>

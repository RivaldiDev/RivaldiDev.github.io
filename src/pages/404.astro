---
import Layout from "@/layouts/Layout.astro";
---
<Layout title="404, halaman tidak ditemukan">
<main>
    <p class="num">ERROR 404</p>
    <h1>Halaman tidak ditemukan.</h1>
    <p>Alamat ini tidak ada, atau sudah dipindahkan.<br>
    <span lang="en">This page doesn't exist, or it has moved.</span></p>
    <a href="/">← Kembali ke beranda / Back home</a>
  </main>
</Layout>
